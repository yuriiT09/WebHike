@using Microsoft.AspNetCore.Http
@using WebHike.Data
@inject HikeDbContext HikeDbContext

@{
    int? userId = Context.Session.GetInt32("UserId");

    var currentUser = userId == null
        ? null
        : HikeDbContext.Users.FirstOrDefault(x => x.Id == userId.Value);

    string userImage = "";

    if (currentUser != null)
    {
        userImage = currentUser.Image == "default.jpg"
            ? "/images/default.jpg"
            : "/images/users/" + currentUser.Image;
    }
}

<!DOCTYPE html>
<html lang="uk">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>@ViewData["Title"] - WebHike</title>
    <link href="/lib/bootstrap/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="/css/site.css" rel="stylesheet">
</head>
<body class="shop-body">
    <header>
        <nav class="navbar navbar-expand-lg navbar-dark fixed-top shop-navbar">
            <div class="container">
                <a class="navbar-brand" asp-controller="Main" asp-action="Index">
                    <span class="brand-dot"></span>
                    WebHike
                </a>

                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNavbar" aria-controls="mainNavbar" aria-expanded="false" aria-label="Меню">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="collapse navbar-collapse" id="mainNavbar">
                    <ul class="navbar-nav ms-auto mb-2 mb-lg-0 align-items-lg-center gap-lg-1">
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Main" asp-action="Index">Категорії</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Item" asp-action="Index">Товари</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link cart-menu-link" asp-controller="Cart" asp-action="Index">Кошик</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-area="Admin" asp-controller="Categories" asp-action="Index">Адмін панель</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Item" asp-action="Create">Додати товар</a>
                        </li>

                        @if (currentUser == null)
                        {
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Account" asp-action="Login">Вхід</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link nav-register-link" asp-controller="Account" asp-action="Register">Реєстрація</a>
                            </li>
                        }
                        else
                        {
                            <li class="nav-item">
                                <div class="user-menu-link">
                                    <img src="@userImage" alt="@currentUser.FirstName">
                                    <span>@currentUser.LastName @currentUser.FirstName</span>
                                </div>
                            </li>
                            <li class="nav-item">
                                <form asp-controller="Account" asp-action="Logout" method="post" class="logout-menu-form">
                                    <button type="submit" class="logout-menu-btn">
                                        Вийти
                                    </button>
                                </form>
                            </li>
                        }
                    </ul>
                </div>
            </div>
        </nav>
    </header>

    <main class="page-main">
        <div class="container">
            @RenderBody()
        </div>
    </main>

    <footer class="shop-footer">
        <div class="container">
            <span>© 2026 WebHike</span>
            <span>Гарного настрою та нових пригод</span>
        </div>
    </footer>

    <script src="/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>