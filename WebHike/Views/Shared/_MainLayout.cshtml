<!DOCTYPE html>
<html lang="uk">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>@ViewData["Title"] - WebHike</title>
    <link href="/lib/bootstrap/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="/css/site.css" rel="stylesheet">
</head>
<body class="shop-body">
    <header>
        <nav class="navbar navbar-expand-lg navbar-dark fixed-top shop-navbar">
            <div class="container">
                <a class="navbar-brand" asp-controller="Main" asp-action="Index">
                    <span class="brand-dot"></span>
                    WebHike
                </a>

                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNavbar" aria-controls="mainNavbar" aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="collapse navbar-collapse" id="mainNavbar">
                    <ul class="navbar-nav ms-auto mb-2 mb-lg-0 align-items-lg-center">
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Main" asp-action="Index">Категорії</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Item" asp-action="Index">Товари</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Main" asp-action="Create">Додати категорію</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Item" asp-action="Create">Додати товар</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Account" asp-action="Login">Вхід</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link nav-register-link" asp-controller="Account" asp-action="Register">Реєстрація</a>
                        </li>
                    </ul>
                </div>
            </div>
        </nav>
    </header>

    <main class="page-main">
        <div class="container">
            @RenderBody()
        </div>
    </main>

    <footer class="shop-footer">
        <div class="container">
            <span>© 2026 WebHike</span>
            <span>Гарного настрою та нових пригод</span>
        </div>
    </footer>

    <script src="/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>