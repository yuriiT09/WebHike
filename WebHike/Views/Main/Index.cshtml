@model List<WebHike.Data.Entities.CategoryEntity>

@{
    Layout = "_MainLayout";
    ViewData["Title"] = "Категорії";
}

<section id="categories" class="category-section">
    <div class="section-heading">
        <span>Наші напрямки</span>
        <h2>Популярні категорії</h2>
        <p>Фото автоматично підлаштовуються під картку, а сітка красиво змінюється на різних екранах.</p>
    </div>

    <div class="row g-4 row-cols-1 row-cols-md-2 row-cols-xl-3">
        @for (int i = 0; i < Model.Count; i++)
        {
            var cat = Model[i];

            var imageSrc = string.IsNullOrWhiteSpace(cat.Image)
            ? "/images/default.jpg"
            : cat.Image.StartsWith("http", StringComparison.OrdinalIgnoreCase)
            ? cat.Image
            : "/images/" + cat.Image;

            <div class="col">
                <article class="category-card h-100">
                    <div class="category-image-box">
                        <img src="@imageSrc" class="category-img" alt="@cat.Name" loading="lazy">
                        <div class="category-number">#@((i + 1).ToString("00"))</div>
                    </div>

                    <div class="category-content">
                        <div>
                            <span class="category-label">Категорія</span>
                            <h3>@cat.Name</h3>
                        </div>

                        <p>
                            Легка добірка для приємної прогулянки, гарних фото та позитивного настрою.
                        </p>

                        <div class="category-buttons">
                            <a href="#" class="category-link">
                                Переглянути
                                <span>→</span>
                            </a>

                            <a asp-action="Edit" asp-route-id="@cat.Id" class="category-edit-link">
                                Редагувати
                            </a>
                        </div>
                    </div>
                </article>
            </div>
        }
    </div>
</section>