@model List<WebHike.Data.Entities.CategoryEntity>

@{
    Layout = "_MainLayout";
    ViewData["Title"] = "Категорії";
}

<section class="hero-categories">
    <div class="hero-content">
        <div class="hero-badge">
            WebHike
        </div>

        <h1 class="hero-title">Маршрути та пригоди</h1>

        <p class="hero-text">
            Обирайте категорію, переглядайте товари та додавайте потрібне у кошик.
        </p>

        <div class="hero-actions">
            <a asp-controller="Item" asp-action="Index" class="btn btn-success hero-btn">
                Переглянути товари
            </a>
            <a asp-controller="Cart" asp-action="Index" class="btn btn-outline-light hero-btn">
                Кошик
            </a>
        </div>
    </div>
</section>

<section class="category-section">
    <div class="section-heading">
        <span>Категорії</span>
        <h2>Основні розділи сайту</h2>
        <p>На сайті користувач переглядає категорії та товари, а керування перенесено в адмін панель.</p>
    </div>

    <div class="row g-4 row-cols-1 row-cols-md-2 row-cols-xl-3">
        @for (int i = 0; i < Model.Count; i++)
        {
            var item = Model[i];

            string imageSrc;

            if (string.IsNullOrWhiteSpace(item.Image) || item.Image == "default.jpg")
            {
                imageSrc = "/images/default.jpg";
            }
            else if (item.Image.StartsWith("http"))
            {
                imageSrc = item.Image;
            }
            else if (item.Image.StartsWith("/"))
            {
                imageSrc = item.Image;
            }
            else
            {
                imageSrc = "/images/" + item.Image;
            }

            <div class="col">
                <article class="category-card">
                    <div class="category-image-box">
                        <img src="@imageSrc" alt="@item.Name" class="category-img">
                        <div class="category-number">
                            @(i + 1)
                        </div>
                    </div>

                    <div class="category-content">
                        <div>
                            <span class="category-label">Категорія</span>
                            <h3>@item.Name</h3>
                            <p>Перейдіть до товарів та оберіть потрібне спорядження для подорожі.</p>
                        </div>

                        <div class="category-buttons">
                            <a asp-controller="Item" asp-action="Index" class="category-link">
                                Переглянути товари
                                <span>→</span>
                            </a>
                        </div>
                    </div>
                </article>
            </div>
        }
    </div>
</section>