@model WebHike.Models.Account.RegisterViewModel

@{
    Layout = "_MainLayout";
    ViewData["Title"] = "Реєстрація";
}

<section class="auth-page">
    <div class="auth-card">
        <div class="auth-info auth-register-bg">
            <span>WebHike</span>
            <h1>Створити акаунт</h1>
            <p>Заповніть форму реєстрації, додайте фото профілю та створіть пароль.</p>
        </div>

        <div class="auth-form-box">
            <div class="auth-heading">
                <span>Реєстрація</span>
                <h2>Новий акаунт</h2>
                <p>Поля мають валідацію, тому форма перевіряє введені дані.</p>
            </div>

            <form asp-action="Register" method="post" enctype="multipart/form-data" class="auth-form">
                <div class="row g-3">
                    <div class="col-md-6">
                        <label asp-for="FirstName" class="form-label"></label>
                        <input asp-for="FirstName" class="form-control auth-input">
                        <span asp-validation-for="FirstName" class="text-danger"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="LastName" class="form-label"></label>
                        <input asp-for="LastName" class="form-control auth-input">
                        <span asp-validation-for="LastName" class="text-danger"></span>
                    </div>
                </div>

                <div class="mt-3">
                    <label asp-for="Email" class="form-label"></label>
                    <input asp-for="Email" class="form-control auth-input">
                    <span asp-validation-for="Email" class="text-danger"></span>
                </div>

                <div class="row g-3 mt-1">
                    <div class="col-md-6">
                        <label asp-for="Password" class="form-label"></label>
                        <input asp-for="Password" class="form-control auth-input">
                        <span asp-validation-for="Password" class="text-danger"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="PasswordConfirm" class="form-label"></label>
                        <input asp-for="PasswordConfirm" class="form-control auth-input">
                        <span asp-validation-for="PasswordConfirm" class="text-danger"></span>
                    </div>
                </div>

                <div class="mt-3">
                    <label asp-for="Image" class="form-label"></label>
                    <input asp-for="Image" class="form-control auth-input" accept="image/*">
                    <span asp-validation-for="Image" class="text-danger"></span>
                </div>

                <button type="submit" class="btn btn-success auth-btn mt-4">
                    Зареєструватися
                </button>

                <div class="auth-bottom-link">
                    Вже маєте акаунт?
                    <a asp-controller="Account" asp-action="Login">Увійти</a>
                </div>
            </form>
        </div>
    </div>
</section>