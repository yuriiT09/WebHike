@model WebHike.Models.Item.ItemCreateViewModel

@{
    Layout = "_MainLayout";
    ViewData["Title"] = "Додати товар";
}

<section class="add-item-page">
    <form asp-action="Create" asp-controller="Item" method="post" enctype="multipart/form-data" class="add-item-form">
        <div class="item-top-grid">
            <div class="mb-3">
                <label asp-for="Name" class="form-label"></label>
                <input asp-for="Name" class="form-control item-input">
                <span asp-validation-for="Name" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="CategoryId" class="form-label"></label>
                <select asp-for="CategoryId" asp-items="Model.Categories" class="form-select item-input">
                    <option value="">Оберіть категорію</option>
                </select>
                <span asp-validation-for="CategoryId" class="text-danger"></span>
            </div>
        </div>

        <div class="editor-card">
            <label asp-for="Description" class="form-label"></label>
            <input asp-for="Description" type="hidden" id="Description">

            <div class="text-editor">
                <div class="text-editor-menu">
                    <button type="button" onclick="formatText('bold')">B</button>
                    <button type="button" onclick="formatText('italic')">I</button>
                    <button type="button" onclick="formatText('justifyLeft')">Left</button>
                    <button type="button" onclick="formatText('justifyCenter')">Center</button>
                    <button type="button" onclick="formatText('justifyRight')">Right</button>
                    <button type="button" onclick="formatText('insertUnorderedList')">List</button>
                    <button type="button" onclick="formatText('insertOrderedList')">1. List</button>
                </div>

                <div id="descriptionEditor" class="text-editor-body" contenteditable="true">
                    @Html.Raw(Model.Description)
                </div>
            </div>

            <span asp-validation-for="Description" class="text-danger"></span>

            <div class="photo-upload-box" id="photoUploadBox">
                <input asp-for="Images" type="file" id="Images" class="d-none" accept="image/*" multiple>
                <span>Drag or select photos</span>
            </div>

            <div class="photo-list" id="photoList"></div>
        </div>

        <div class="item-form-actions">
            <button type="submit" class="btn btn-success">
                Зберегти
            </button>

            <a asp-controller="Main" asp-action="Index" class="btn btn-outline-dark">
                Назад
            </a>
        </div>
    </form>
</section>

@section Scripts {
    <script>
        const form = document.querySelector('.add-item-form');
        const descriptionInput = document.getElementById('Description');
        const descriptionEditor = document.getElementById('descriptionEditor');

        const photoInput = document.getElementById('Images');
        const photoBox = document.getElementById('photoUploadBox');
        const photoList = document.getElementById('photoList');

        let selectedFiles = [];
        let draggedIndex = null;

        function formatText(command) {
            document.execCommand(command, false, null);
            descriptionEditor.focus();
            saveDescription();
        }

        function saveDescription() {
            descriptionInput.value = descriptionEditor.innerHTML;
        }

        descriptionEditor.addEventListener('input', saveDescription);
        descriptionEditor.addEventListener('keyup', saveDescription);
        descriptionEditor.addEventListener('mouseup', saveDescription);

        photoBox.addEventListener('click', function () {
            photoInput.click();
        });

        photoInput.addEventListener('change', function () {
            addPhotos(Array.from(photoInput.files));
        });

        photoBox.addEventListener('dragover', function (e) {
            e.preventDefault();
            photoBox.classList.add('photo-upload-box-active');
        });

        photoBox.addEventListener('dragleave', function () {
            photoBox.classList.remove('photo-upload-box-active');
        });

        photoBox.addEventListener('drop', function (e) {
            e.preventDefault();
            photoBox.classList.remove('photo-upload-box-active');
            addPhotos(Array.from(e.dataTransfer.files));
        });

        form.addEventListener('submit', function () {
            saveDescription();
            updatePhotoInput();
        });

        function addPhotos(files) {
            for (let i = 0; i < files.length; i++) {
                if (files[i].type.startsWith('image/')) {
                    selectedFiles.push(files[i]);
                }
            }

            updatePhotoInput();
            renderPhotos();
        }

        function removePhoto(index) {
            selectedFiles.splice(index, 1);
            updatePhotoInput();
            renderPhotos();
        }

        function changePhotoPosition(from, to) {
            if (from === null || from === to) {
                return;
            }

            const file = selectedFiles[from];
            selectedFiles.splice(from, 1);
            selectedFiles.splice(to, 0, file);

            updatePhotoInput();
            renderPhotos();
        }

        function updatePhotoInput() {
            const dataTransfer = new DataTransfer();

            for (let i = 0; i < selectedFiles.length; i++) {
                dataTransfer.items.add(selectedFiles[i]);
            }

            photoInput.files = dataTransfer.files;
        }

        function renderPhotos() {
            photoList.innerHTML = '';

            for (let i = 0; i < selectedFiles.length; i++) {
                const photo = document.createElement('div');
                photo.className = 'photo-card';
                photo.draggable = true;

                const image = document.createElement('img');
                image.src = URL.createObjectURL(selectedFiles[i]);

                const number = document.createElement('span');
                number.className = 'photo-number';
                number.innerText = i + 1;

                const remove = document.createElement('button');
                remove.type = 'button';
                remove.className = 'photo-delete';
                remove.innerText = '×';

                remove.addEventListener('click', function () {
                    removePhoto(i);
                });

                photo.addEventListener('dragstart', function () {
                    draggedIndex = i;
                    photo.classList.add('photo-dragging');
                });

                photo.addEventListener('dragend', function () {
                    draggedIndex = null;
                    photo.classList.remove('photo-dragging');
                });

                photo.addEventListener('dragover', function (e) {
                    e.preventDefault();
                });

                photo.addEventListener('drop', function (e) {
                    e.preventDefault();
                    changePhotoPosition(draggedIndex, i);
                });

                photo.appendChild(image);
                photo.appendChild(number);
                photo.appendChild(remove);
                photoList.appendChild(photo);
            }
        }

        saveDescription();
    </script>
}