@model List<AdminItemVM>

@{
    ViewData["Title"] = "Товари";
}

<div class="admin-page-head">
    <div>
        <span>Адмін панель</span>
        <h1>Товари</h1>
        <p>Керування товарами винесено в адмін панель, а користувач на сайті тільки переглядає товари.</p>
    </div>

    <a asp-area="Admin" asp-controller="Items" asp-action="Create" class="btn btn-success admin-add-btn">
        Додати товар
    </a>
</div>

@if (Model.Count == 0)
{
    <div class="admin-empty">
        <h2>Товарів поки немає</h2>
        <p>Створіть перший товар для сайту.</p>
        <a asp-area="Admin" asp-controller="Items" asp-action="Create" class="btn btn-dark">
            Додати товар
        </a>
    </div>
}
else
{
    <div class="admin-table-card">
        <table class="table admin-table align-middle">
            <thead>
                <tr>
                    <th>Фото</th>
                    <th>Назва</th>
                    <th>Категорія</th>
                    <th>Фото</th>
                    <th class="text-end">Дії</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    string imageSrc = item.Image == "default.jpg"
                    ? "/images/default.jpg"
                    : "/images/items/" + item.Image;

                    <tr>
                        <td>
                            <img src="@imageSrc" alt="@item.Name" class="admin-category-img">
                        </td>
                        <td>
                            <strong>@item.Name</strong>
                        </td>
                        <td>@item.CategoryName</td>
                        <td>@item.ImagesCount</td>
                        <td>
                            <div class="admin-row-actions">
                                <a asp-area="Admin" asp-controller="Items" asp-action="Edit" asp-route-id="@item.Id" class="btn btn-outline-dark">
                                    Редагувати
                                </a>

                                <form asp-area="Admin" asp-controller="Items" asp-action="Delete" asp-route-id="@item.Id" method="post">
                                    <button type="submit" class="btn btn-outline-danger" onclick="return confirm('Видалити товар?')">
                                        Видалити
                                    </button>
                                </form>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}