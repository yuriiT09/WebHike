@model CategoryEditVM

@{
    ViewData["Title"] = "Редагувати категорію";

    string imageSrc;

    if (string.IsNullOrWhiteSpace(Model.CurrentImage) || Model.CurrentImage == "default.jpg")
    {
        imageSrc = "/images/default.jpg";
    }
    else if (Model.CurrentImage.StartsWith("http"))
    {
        imageSrc = Model.CurrentImage;
    }
    else if (Model.CurrentImage.StartsWith("/"))
    {
        imageSrc = Model.CurrentImage;
    }
    else
    {
        imageSrc = "/images/" + Model.CurrentImage;
    }
}

<div class="admin-page-head">
    <div>
        <span>Категорії</span>
        <h1>Редагувати категорію</h1>
        <p>Можна змінити назву, slug та фото категорії.</p>
    </div>

    <a asp-area="Admin" asp-controller="Categories" asp-action="Index" class="btn btn-outline-dark admin-add-btn">
        Назад
    </a>
</div>

<div class="admin-edit-card">
    <div class="admin-edit-image">
        <img src="@imageSrc" alt="@Model.Name">
    </div>

    <form asp-area="Admin" asp-controller="Categories" asp-action="Edit" method="post" enctype="multipart/form-data">
        <input asp-for="Id" type="hidden">
        <input asp-for="CurrentImage" type="hidden">

        <div class="mb-3">
            <label asp-for="Name" class="form-label"></label>
            <input asp-for="Name" class="form-control admin-input">
            <span asp-validation-for="Name" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="Slug" class="form-label"></label>
            <input asp-for="Slug" class="form-control admin-input">
            <span asp-validation-for="Slug" class="text-danger"></span>
        </div>

        <div class="mb-4">
            <label asp-for="Image" class="form-label"></label>
            <input asp-for="Image" class="form-control admin-input" accept="image/*">
            <span asp-validation-for="Image" class="text-danger"></span>
        </div>

        <button type="submit" class="btn btn-success admin-save-btn">
            Зберегти зміни
        </button>
    </form>
</div>