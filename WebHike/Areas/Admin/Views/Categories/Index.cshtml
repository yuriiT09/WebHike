@model List<CategoryItemVM>

@{
    ViewData["Title"] = "Категорії";
}

<div class="admin-page-head">
    <div>
        <span>Адмін панель</span>
        <h1>Категорії</h1>
        <p>Створення, редагування та видалення категорій перенесено в адмін панель.</p>
    </div>

    <a asp-area="Admin" asp-controller="Categories" asp-action="Create" class="btn btn-success admin-add-btn">
        Додати категорію
    </a>
</div>

@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger admin-alert">
        @TempData["ErrorMessage"]
    </div>
}

@if (Model.Count == 0)
{
    <div class="admin-empty">
        <h2>Категорій поки немає</h2>
        <p>Створіть першу категорію для товарів.</p>
        <a asp-area="Admin" asp-controller="Categories" asp-action="Create" class="btn btn-dark">
            Додати категорію
        </a>
    </div>
}
else
{
    <div class="admin-table-card">
        <table class="table admin-table align-middle">
            <thead>
                <tr>
                    <th>Фото</th>
                    <th>Назва</th>
                    <th>Slug</th>
                    <th>Товари</th>
                    <th class="text-end">Дії</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    string imageSrc;

                    if (string.IsNullOrWhiteSpace(item.Image) || item.Image == "default.jpg")
                    {
                        imageSrc = "/images/default.jpg";
                    }
                    else if (item.Image.StartsWith("http"))
                    {
                        imageSrc = item.Image;
                    }
                    else if (item.Image.StartsWith("/"))
                    {
                        imageSrc = item.Image;
                    }
                    else
                    {
                        imageSrc = "/images/" + item.Image;
                    }

                    <tr>
                        <td>
                            <img src="@imageSrc" alt="@item.Name" class="admin-category-img">
                        </td>
                        <td>
                            <strong>@item.Name</strong>
                        </td>
                        <td>@item.Slug</td>
                        <td>@item.ItemsCount</td>
                        <td>
                            <div class="admin-row-actions">
                                <a asp-area="Admin" asp-controller="Categories" asp-action="Edit" asp-route-id="@item.Id" class="btn btn-outline-dark">
                                    Редагувати
                                </a>

                                <form asp-area="Admin" asp-controller="Categories" asp-action="Delete" asp-route-id="@item.Id" method="post">
                                    <button type="submit" class="btn btn-outline-danger" onclick="return confirm('Видалити категорію?')">
                                        Видалити
                                    </button>
                                </form>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}