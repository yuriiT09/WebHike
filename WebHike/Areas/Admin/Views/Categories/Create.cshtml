@model CategoryCreateVM

@{
    ViewData["Title"] = "Додати категорію";
}

<div class="admin-page-head">
    <div>
        <span>Категорії</span>
        <h1>Додати категорію</h1>
        <p>Заповніть дані категорії та додайте фото.</p>
    </div>

    <a asp-area="Admin" asp-controller="Categories" asp-action="Index" class="btn btn-outline-dark admin-add-btn">
        Назад
    </a>
</div>

<div class="admin-form-card">
    <form asp-area="Admin" asp-controller="Categories" asp-action="Create" method="post" enctype="multipart/form-data">
        <div class="mb-3">
            <label asp-for="Name" class="form-label"></label>
            <input asp-for="Name" class="form-control admin-input">
            <span asp-validation-for="Name" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="Slug" class="form-label"></label>
            <input asp-for="Slug" class="form-control admin-input">
            <span asp-validation-for="Slug" class="text-danger"></span>
        </div>

        <div class="mb-4">
            <label asp-for="Image" class="form-label"></label>
            <input asp-for="Image" class="form-control admin-input" accept="image/*">
            <span asp-validation-for="Image" class="text-danger"></span>
        </div>

        <button type="submit" class="btn btn-success admin-save-btn">
            Зберегти
        </button>
    </form>
</div>